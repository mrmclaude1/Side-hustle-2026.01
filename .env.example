# Copy to .env (and load it in your process manager) to configure Marketsonar.
# The app runs with none of these set — they unlock persistence and billing.

# --- Data / history -------------------------------------------------------
# SQLite path for history + alerts + API keys. ":memory:" disables on-disk.
MARKETSONAR_DB=marketsonar.db
# Force the bundled market snapshot instead of live APIs (demo mode).
# MARKETSONAR_DEMO=1

# --- Alerts delivery ------------------------------------------------------
# Incoming-webhook URL for alert pushes (Discord/Slack/Telegram relay/any).
# MARKETSONAR_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- Pro tier / billing (set these to go live) ----------------------------
# Protects manual API-key provisioning (POST /api/keys with X-Admin-Token).
# MARKETSONAR_ADMIN_TOKEN=change-me-to-a-long-random-string
# Verifies Stripe webhooks at POST /api/billing/webhook. REQUIRED in prod —
# without it the webhook accepts unverified events (dev/demo only).
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Disable per-plan rate limiting (tests set this; leave unset in prod).
# MARKETSONAR_DISABLE_RATELIMIT=1
